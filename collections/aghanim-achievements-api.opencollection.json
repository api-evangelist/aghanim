{
  "opencollection": "1.0.0",
  "info": {
    "name": "Aghanim Server-to-Server Achievements API",
    "version": "2026.07.14"
  },
  "items": [
    {
      "info": {
        "name": "Achievements",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Achievements",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.aghanim.com/s2s/v1/achievements",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "A limit on the number of objects to be returned"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "The number of objects to skip"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a list of achievements."
        },
        {
          "info": {
            "name": "Create Achievement",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.aghanim.com/s2s/v1/achievements",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create Achievement"
        },
        {
          "info": {
            "name": "Bulk Update Achievement",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.aghanim.com/s2s/v1/achievements",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Updates multiple store items."
        },
        {
          "info": {
            "name": "Get Achievement",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.aghanim.com/s2s/v1/achievements/:achievement_id",
            "params": [
              {
                "name": "achievement_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a single achievement."
        },
        {
          "info": {
            "name": "Update Achievement",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.aghanim.com/s2s/v1/achievements/:achievement_id",
            "params": [
              {
                "name": "achievement_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Updates an achievement."
        },
        {
          "info": {
            "name": "Delete Achievement",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.aghanim.com/s2s/v1/achievements/:achievement_id",
            "params": [
              {
                "name": "achievement_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Deletes an achievement."
        },
        {
          "info": {
            "name": "Unlock Achievement",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.aghanim.com/s2s/v1/achievements/:achievement_type/unlock",
            "params": [
              {
                "name": "achievement_type",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Unlock an achievement for a player."
        }
      ]
    }
  ],
  "bundled": true
}