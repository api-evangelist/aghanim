          "http": {
            "method": "PUT",
            "url": "https://api.aghanim.com/s2s/v1/webhooks/:webhook_id",
            "params": [
              {
                "name": "webhook_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Updates a webhook."
        },
        {
          "info": {
            "name": "Delete Webhook",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.aghanim.com/s2s/v1/webhooks/:webhook_id",
            "params": [
              {
                "name": "webhook_id",
                "value": "",
