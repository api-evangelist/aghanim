          "info": {
            "name": "Expire Webhook Secret",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.aghanim.com/s2s/v1/webhooks/:webhook_id/expire_secret",
            "params": [
              {
                "name": "webhook_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Expires the secret of a webhook."
