{
  "opencollection": "1.0.0",
  "info": {
    "name": "Aghanim Server-to-Server Achievements Users API",
    "version": "2026.07.14"
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Authorize User",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.aghanim.com/s2s/v1/users/authorize",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Generate an authorization URL to log in a player on the Game Hub."
        },
        {
          "info": {
            "name": "Authenticate User",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.aghanim.com/s2s/v1/users/authenticate",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Authenticate a user using a one-time token. Game Hub generates and sends this token\nto the game client to process the user's authentication flow with the game server.\n\nThe token is valid for a single use and expires after a short period."
        },
        {
          "info": {
            "name": "Get User",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.aghanim.com/s2s/v1/users/:user_id",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve a user by their ID."
        },
        {
          "info": {
            "name": "Link Player",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.aghanim.com/s2s/v1/users/:user_id/link_player",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Link a player to a user."
        },
        {
          "info": {
            "name": "Unlink Player",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.aghanim.com/s2s/v1/users/:user_id/unlink_player",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Unlink a player from a user."
        }
      ]
    }
  ],
  "bundled": true
}