{
  "opencollection": "1.0.0",
  "info": {
    "name": "Aghanim Server-to-Server Achievements Leaderboards API",
    "version": "2026.07.14"
  },
  "items": [
    {
      "info": {
        "name": "Leaderboards",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Leaderboards",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.aghanim.com/s2s/v1/leaderboards",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "A limit on the number of objects to be returned"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "The number of objects to skip"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a list of leaderboards."
        },
        {
          "info": {
            "name": "Create Leaderboard",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.aghanim.com/s2s/v1/leaderboards",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates a new leaderboard."
        },
        {
          "info": {
            "name": "Get Leaderboard",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.aghanim.com/s2s/v1/leaderboards/:leaderboard_id",
            "params": [
              {
                "name": "leaderboard_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a single leaderboard."
        },
        {
          "info": {
            "name": "Update Leaderboard",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.aghanim.com/s2s/v1/leaderboards/:leaderboard_id",
            "params": [
              {
                "name": "leaderboard_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Updates a leaderboard."
        },
        {
          "info": {
            "name": "Delete Leaderboard",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.aghanim.com/s2s/v1/leaderboards/:leaderboard_id",
            "params": [
              {
                "name": "leaderboard_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Deletes a leaderboard."
        },
        {
          "info": {
            "name": "Get Leaderboard Members",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.aghanim.com/s2s/v1/leaderboards/:leaderboard_id/members",
            "params": [
              {
                "name": "leaderboard_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "A limit on the number of objects to be returned"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "The number of objects to skip"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a list of leaderboard members."
        },
        {
          "info": {
            "name": "Update Leaderboard Member",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.aghanim.com/s2s/v1/leaderboards/:leaderboard_id/members/:member_id",
            "params": [
              {
                "name": "member_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "leaderboard_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update Leaderboard Member"
        },
        {
          "info": {
            "name": "Submit Score",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.aghanim.com/s2s/v1/leaderboards/:leaderboard_id/submit_score",
            "params": [
              {
                "name": "leaderboard_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Submit Score"
        }
      ]
    }
  ],
  "bundled": true
}