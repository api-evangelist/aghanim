            "name": "Issue Loyalty Points",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.aghanim.com/s2s/v1/loyalty/:loyalty_settings_id/issue_points",
            "params": [
              {
                "name": "loyalty_settings_id",
                "value": "",
                "type": "path"
              }
